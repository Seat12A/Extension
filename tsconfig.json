{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["chrome", "vite/client", "vite-plugin-svgr/client", "node"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/ui/*"], "~/*": ["./src/*"] }
  },
  "include": ["src", "test", "scripts/*.ts", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
