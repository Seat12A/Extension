# Copy to .env.local to override. Defaults (no file): production.
# Origin of the Tower gate API (also written into host_permissions).
VITE_GATE_URL=https://api.seat12a.org
# Public website (privacy policy, cases, badge request page).
VITE_SITE_URL=https://seat12a.org
# Local development against `uv run tower gate`:
# VITE_GATE_URL=http://localhost:8000
